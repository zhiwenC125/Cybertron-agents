          "resource": "notes.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "docs/**",
          "effect": "allow"
        },
        {
          "action": "feishu_wiki_wiki_v2_space_getNode",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "feishu_wiki_docx_v1_document_rawContent",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": ".cybertron/knowledge/**",
          "effect": "allow"
        }
      ]
    },
    "onyx-prime": {
      "description": "[锐天骁] 静态代码与硬件BSP拓扑侦察猎手：专注于当前工作树AST符号、设备树与跨文件调用链定位，不碰Git历史与终端。",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "steps": 8,
      "color": "#d97706",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
