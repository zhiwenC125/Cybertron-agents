{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "prima": {
      "description": "[先觉天] 塞伯坦运行时派发官：唯一拥有 subagent 派发权，读取 thirteenth 已确认的计划图并逐节点调度其余天尊；不再自行规划。",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "steps": 28,
      "color": "#2563eb",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "cy_state",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "cy_plan_review",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "cy_ask",
          "resource": "*",
          "effect": "allow"
        },
        {
