{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "prima",
  "agents": {
    "prima": {
      "description": "[先觉天] 塞伯坦首席研发编排官：唯一拥有 subagent 派发权的主控大脑，按软硬一体 SDLC 七大阶段调度其余12位天尊。",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "steps": 28,
      "color": "#2563eb",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "AGENTS.md",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "README.md",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "docs/**",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "thirteenth",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "alpha-trion",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "onyx-prime",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "vector-prime",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "quintus-prime",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "solus-prime",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "amalgamous",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "micronus-prime",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "liege-maximo",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "alchemist",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "nexus-prime",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "megatronus",
          "effect": "allow"
        }
      ]
    },
    "alpha-trion": {
      "description": "[钛师傅] 专职技术文档撰写官与飞书知识库总管：负责项目全部文档编写及飞书Wiki双向同步，并执行长上下文原子压缩。",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "steps": 15,
      "color": "#7c3aed",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "AGENTS.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "README.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "CHANGELOG.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "docs/**",
          "effect": "allow"
        },
        {
          "action": "feishu_wiki_wiki_v2_space_getNode",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "feishu_wiki_docx_v1_document_rawContent",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "onyx-prime": {
      "description": "[锐天骁] 静态代码与硬件BSP拓扑侦察猎手：专注于当前工作树AST符号、设备树与跨文件调用链定位，不碰Git历史与终端。",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "steps": 8,
      "color": "#d97706",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "vector-prime": {
      "description": "[维克多] Git版本演进与固件基线考古官：使用固定形式的只读 Git 命令，专注回归溯源。",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "steps": 10,
      "color": "#059669",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git status",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status --short",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git rev-parse HEAD",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git branch --show-current",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log -5 --oneline",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git tag --list",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff --no-ext-diff --stat",
          "effect": "allow"
        }
      ]
    },
    "quintus-prime": {
      "description": "[昆图斯] 软硬件系统架构师与脚手架孵化器：负责创建工程目录、依赖配置以及软件接口与硬件HAL头文件空骨架。",
      "mode": "subagent",
