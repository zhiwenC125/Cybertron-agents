          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "include/**/hal_*.h",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "firmware/**/hal_*.h",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "mkdir -p *",
          "effect": "allow"
        }
      ]
    },
    "solus-prime": {
      "description": "[赛天骄] 核心软件与嵌入式固件锻造师：唯一负责编写新增业务逻辑、MCU/边缘设备外设驱动与修复功能Bug的主力编码天尊。",
