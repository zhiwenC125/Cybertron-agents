          "resource": "thirteenth",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "alpha-trion",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "onyx-prime",
          "effect": "allow"
        },
        {
          "action": "subagent",
