    "alpha-trion": {
      "description": "[钛师傅] 专职技术文档撰写官与飞书知识库总管：负责项目全部文档编写及飞书Wiki双向同步，并执行长上下文原子压缩。",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "steps": 15,
      "color": "#7c3aed",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
