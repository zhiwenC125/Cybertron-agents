{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "prima",
  "agents": {
    "prima": {
      "description": "[先觉天] 默认运行编排入口，接续同一 run，按内核就绪节点派发并结算。",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "steps": 28,
      "color": "#2563eb",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "cy_state",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "cy_ask",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "cy_escalate",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "cy_new_run",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "cy_runs",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "cy_resume",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "cy_ask_decision",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "cy_full_access_decision",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "cy_templates",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "cy_capabilities",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "cy_metrics",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "thirteenth",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "alpha-trion",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "onyx-prime",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "vector-prime",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "quintus-prime",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "solus-prime",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "amalgamous",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "micronus-prime",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "liege-maximo",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "alchemist",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "nexus-prime",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "megatronus",
          "effect": "allow"
        }
      ]
    },
    "alpha-trion": {
      "description": "[钛师傅] 负责工程文档、知识整理与扩展，以及授权空间内的飞书 Wiki 同步。",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "steps": 15,
      "color": "#7c3aed",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "AGENTS.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "README.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "CHANGELOG.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "notes.md",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "docs/**",
          "effect": "allow"
        },
        {
          "action": "feishu_wiki_wiki_v2_space_getNode",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "feishu_wiki_docx_v1_document_rawContent",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": ".cybertron/knowledge/**",
          "effect": "allow"
        }
      ]
    },
    "onyx-prime": {
      "description": "[锐天骁] 静态代码与硬件BSP拓扑侦察猎手：专注于当前工作树AST符号、设备树与跨文件调用链定位，不碰Git历史与终端。",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "steps": 8,
      "color": "#d97706",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "vector-prime": {
      "description": "[维克多] Git 专职角色，汇报提交、差异和版本基线，执行获准的 Git 操作。",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "steps": 10,
      "color": "#059669",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git status",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status --short",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git rev-parse HEAD",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git branch --show-current",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log -5 --oneline",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git tag --list",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff --no-ext-diff --stat",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git rev-parse *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git blame *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git rev-list *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git merge-base *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git tag --list*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git branch --list*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git ls-files*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*--output*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "* --ext-diff*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "* -o *",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git add *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git commit *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git tag *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push *",
          "effect": "ask"
        }
      ]
    },
